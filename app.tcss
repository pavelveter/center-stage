Screen {
    align-horizontal: center;
}
#panel {
    width: 100%;
    max-width: 72;
    height: 1fr;
    border: round $primary;
    padding: 0 1 1 1;
}
.panel-title {
    color: $accent;
    text-style: bold;
    margin-top: 1;
}
.panel-title.first {
    margin-top: 0;
}
#telemetry-body {
    height: 1;
}
.notice {
    color: $text-muted;
    height: 1;
}
.row {
    height: 1;
    margin-bottom: 1;
}
.name {
    width: 22;
    margin-right: 2;
}
.row Switch {
    width: 6;
    height: 1;
    padding: 0;
    border: none;
    margin: 0 4 0 0;
}
.switch-spacer {
    width: 6;
    margin-right: 4;
}
.tuner-name {
    width: 9;
    color: $text-muted;
    margin-right: 1;
}
.row Button {
    width: 3;
    min-width: 3;
    height: 1;
    border: none;
    background: $surface-lighten-2;
    margin: 0;
}
.row Input {
    width: 8;
    height: 1;
    border: none;
    padding: 0 1;
    margin: 0 1;
}
#lut-select {
    width: 1fr;
    height: 1;
    border: none;
    background: $surface-lighten-2;
    margin-bottom: 1;
}
#lut-select SelectCurrent {
    border: none !important;
    height: 1;
    padding: 0 1;
}
#shader-select {
    width: 1fr;
    height: 1;
    border: none;
    background: $surface-lighten-2;
    margin-bottom: 1;
}
#shader-select SelectCurrent {
    border: none !important;
    height: 1;
    padding: 0 1;
}
